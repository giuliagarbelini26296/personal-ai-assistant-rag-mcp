# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
# Vector store: sqlite (padrão, sem servidor) | pgvector (docker compose -p rag-mcp up -d pgvector)
VECTOR_STORE=sqlite
ASSISTANT_DB_PATH=assistant.sqlite3
DATABASE_URL=postgresql://rag:rag-local-only@127.0.0.1:55433/rag

# Embeddings: hash (offline, padrão) | gemini | openai | ollama
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_DIM=768

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# LLM: fake (offline, determinístico, padrão) | openai | ollama
LLM_PROVIDER=fake
LLM_MODEL=

# OpenAI (ou qualquer endpoint compatível com a API da OpenAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Ajustes de RAG / agente
CHUNK_SIZE=120
CHUNK_OVERLAP=30
# repete o título do documento ("# ...") em cada chunk; útil quando os documentos se parecem muito
CHUNK_TITLE_PREFIX=false
CONTEXT_TOKEN_BUDGET=1500
MAX_AGENT_STEPS=4
LOG_LEVEL=INFO

# Observabilidade: none (padrão) | console | jsonl | otlp | otlp,jsonl
# Phoenix local: docker compose -p rag-mcp up -d phoenix  →  http://127.0.0.1:6006
OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTEL_JSONL_PATH=traces/spans.jsonl
# Preço por 1M de tokens para modelos fora da tabela (opcional)
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
